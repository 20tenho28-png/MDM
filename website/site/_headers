# Cache no navegador (Netlify). As imagens, as letras e os logótipos mudam raramente; o HTML, o CSS e o JS ficam sempre frescos.
/assets/img/*
  Cache-Control: public, max-age=2592000
/assets/fonts/*
  Cache-Control: public, max-age=31536000, immutable
/assets/brands/*
  Cache-Control: public, max-age=2592000
